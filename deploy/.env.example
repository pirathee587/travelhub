# ==============================================================================
# TravelHub Production Environment Variables Template (.env)
# ==============================================================================
# Save this file as `.env` on your AWS EC2 instance in ~/travelhub/.env
# ==============================================================================

# ── 1. Database (Supabase PostgreSQL Session Pooler - IPv4) ────────────────────
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password

# ── 2. Supabase Storage API ──────────────────────────────────────────────────
SUPABASE_URL=https://gzkohtgqtpbscczxuaaj.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# ── 3. Application Security (JWT) ────────────────────────────────────────────
# Generate a secure 256-bit random secret string: openssl rand -base64 48
JWT_SECRET=your_super_long_and_secure_jwt_secret_key_travelhub_2026_minimum_32_chars

# ── 4. Email Notification Service (Gmail SMTP) ──────────────────────────────
# Generate App Password in Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USERNAME=davidthanu1006@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_character_app_password

# ── 5. Payment Gateway (PayHere Sandbox / Live) ───────────────────────────────
PAYHERE_MERCHANT_ID=1235619
PAYHERE_SECRET=your_payhere_merchant_secret
PAYHERE_CURRENCY=USD
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout

# ── 6. CORS & Frontend Origin Settings ────────────────────────────────────────
# APP_BASE_URL: used in verification emails, password-reset links, PayHere return/cancel URLs
# CORS: must include your live Netlify URL(s) + local dev ports
CORS_ALLOWED_ORIGINS=https://travelhublanka.netlify.app,https://travelhub.netlify.app,http://localhost:5173,http://localhost:5174,http://localhost:3000
APP_BASE_URL=https://travelhublanka.netlify.app
# Public backend URL for PayHere webhooks (not the Netlify /api proxy)
APP_BACKEND_URL=http://YOUR_EC2_PUBLIC_IP:8080

# ── 7. AI Chatbot Service (FastAPI + Groq LLM) ────────────────────────────────
GROQ_API_KEY=your_groq_api_key_gsk_xxxx
SPRING_BOOT_URL=http://backend:8080
CHATBOT_SERVICE_URL=http://chatbot:8001
