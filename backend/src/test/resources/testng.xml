    <test name="Unit Tests - Tourist">
        <classes>
            <class name="com.travelhub.backend.unit.tourist.BookingServiceTest"/>
            <class name="com.travelhub.backend.unit.tourist.BookingCreationServiceTest"/>
            <class name="com.travelhub.backend.unit.tourist.PackageServiceTest"/>
            <class name="com.travelhub.backend.unit.tourist.ReviewServiceTest"/>
            <class name="com.travelhub.backend.unit.tourist.UserNotificationServiceTest"/>
        </classes>
    </test>

    <test name="Unit Tests - User and Profile">
        <classes>
            <class name="com.travelhub.backend.unit.user.UserServiceTest"/>
