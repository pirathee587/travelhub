            <class name="com.travelhub.backend.unit.hotelowner.ReviewServiceTest"/>
            <class name="com.travelhub.backend.unit.hotelowner.UserNotificationServiceTest"/>
        </classes>
    </test>

    <test name="Unit Tests - Agency">
        <classes>
            <class name="com.travelhub.backend.unit.agency.AgentServiceTest"/>
        </classes>
    </test>

